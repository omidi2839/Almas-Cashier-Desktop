<Window x:Class="AlmasCashierDesktop.WpfDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="الماس | فروش و حسابداری — 0.2.5" Width="1440" Height="850" MinWidth="980" MinHeight="620"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F6F2EE"
 FontFamily="./Fonts/#Vazirmatn, Tahoma, Segoe UI" FontSize="12" Foreground="#302B28"
 FlowDirection="RightToLeft" Language="fa-IR" UseLayoutRounding="True" SnapsToDevicePixels="True"
 TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#DE7418"/>
  <SolidColorBrush x:Key="Ink" Color="#302B28"/>
  <SolidColorBrush x:Key="Muted" Color="#80746A"/>
  <SolidColorBrush x:Key="Edge" Color="#E8DED5"/>
  <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#FFFDFA"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="16"/>
  </Style>
  <Style TargetType="Button" x:Key="Secondary">
   <Setter Property="Background" Value="#FFFDFA"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.83"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#B8753F"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Secondary}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="Button" x:Key="Nav" BasedOn="{StaticResource Secondary}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Height" Value="41"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/>
   <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="7">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#D98547"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F4EAE0"/><Setter Property="Foreground" Value="#5A4739"/><Setter Property="Height" Value="40"/>
   <Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Right"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="#FFFDFB"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F0E8E0"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FBF4EA"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F9E8D6"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="NumericCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Right"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#FFFCF8" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
   <Grid Margin="13,16,13,8">
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Center">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Path Width="29" Height="29" Stretch="Uniform" Fill="{StaticResource Accent}" Data="M15,0 L30,15 15,30 0,15 Z M15,5 L5,15 15,25 25,15 Z" Margin="0,0,9,0"/>
      <TextBlock Text="الماس" FontSize="24" FontWeight="Bold" Foreground="#934C17"/>
     </StackPanel>
     <TextBlock Text="فروش و حسابداری" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
    <Viewbox Grid.Row="2" Stretch="Uniform" Opacity="0.36" Margin="0,10,0,0">
     <Canvas Width="178" Height="72">
      <Path Stroke="#C38B59" StrokeThickness="1.5" Fill="#F6E4CA" Data="M0,69 L0,51 13,51 13,42 29,42 29,69 M35,69 L35,39 51,39 51,30 66,30 66,69 M76,69 L76,48 101,48 101,37 98,37 98,28 95,28 95,20 92,20 92,11 89,3 86,11 86,20 83,20 83,28 80,28 80,37 76,37 Z M108,69 L108,47 124,47 124,36 139,36 139,69 M147,69 L147,52 169,52 169,69 Z"/>
      <Path Stroke="#C38B59" StrokeThickness="2" Data="M21,69 L21,24 M21,24 Q8,10 1,25 M21,24 Q27,8 41,21 M21,24 Q18,7 11,9 M157,69 L157,20 M157,20 Q144,7 138,19 M157,20 Q169,5 177,20 M157,20 Q156,5 151,3"/>
     </Canvas>
    </Viewbox>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="18,14,18,12">
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Padding="15,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="داشبورد" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ModeLabel" Text="شعبه نجف  •  محیط آزمایشی" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
     <Border Grid.Column="1" Background="#F6EEE4" CornerRadius="7" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="●  متصل نیست" Foreground="#91612F" FontSize="11"/></Border>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ConnectButton" Content="اتصال به سامانه" Style="{StaticResource Secondary}" Click="CheckConnection_Click" Margin="0,0,10,0"/><TextBlock x:Name="RoleLabel" Text="صندوقدار آزمایشی" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" x:Name="DashboardView">
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="12"/><RowDefinition Height="52"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ItemsControl x:Name="Metrics">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12,9">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Muted}"/>
         <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/>
         <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" Background="{Binding Tint}" VerticalAlignment="Center">
         <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" Foreground="{Binding Color}" FontSize="17" HorizontalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,6">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <Button x:Name="CreateButton" Content="＋ ایجاد فاکتور" Style="{StaticResource Primary}" Click="Create_Click" Margin="0,0,8,0"/>
      <Button x:Name="PayButton" Grid.Column="1" Content="ثبت دریافت" Style="{StaticResource Secondary}" Click="Payment_Click" Margin="0,0,8,0"/>
      <Button x:Name="ReceiptButton" Grid.Column="2" Content="چاپ رسید" Style="{StaticResource Secondary}" Click="Receipt_Click"/>
      <Grid Grid.Column="4"><TextBox x:Name="SearchBox" Padding="10,6" TextChanged="Search_Changed" ToolTip="جستجوی شماره یا مشتری"/><TextBlock x:Name="SearchHint" Text="جستجوی شماره یا مشتری..." Foreground="#9A8C80" FontSize="11" Margin="11,0" IsHitTestVisible="False"/></Grid>
     </Grid>
    </Border>
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TableTitle" Text="آخرین فاکتورها" FontSize="15" FontWeight="SemiBold"/>
       <TextBlock x:Name="TableNote" Grid.Column="1" Text="داده‌های نمونه • بدون اثر مالی" FontSize="10" Foreground="{StaticResource Muted}"/>
      </Grid>
      <DataGrid x:Name="InvoicesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
       CanUserSortColumns="True" CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
       AlternatingRowBackground="#FCF8F4" AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True"
       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="12" RowHeight="46">
       <DataGrid.Columns>
        <DataGridTextColumn Header="شماره" Binding="{Binding Number}" ElementStyle="{StaticResource NumericCell}" Width="1.05*" MinWidth="92"/>
        <DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" ElementStyle="{StaticResource CellText}" Width="1.65*" MinWidth="118"/>
        <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalText}" SortMemberPath="Total" ElementStyle="{StaticResource NumericCell}" Width="1.1*" MinWidth="95"/>
        <DataGridTextColumn Header="پرداخت" Binding="{Binding PaidText}" SortMemberPath="Paid" ElementStyle="{StaticResource NumericCell}" Width="1.1*" MinWidth="95"/>
        <DataGridTextColumn Header="مانده" Binding="{Binding RemainingText}" SortMemberPath="Remaining" ElementStyle="{StaticResource NumericCell}" Width="1.1*" MinWidth="95"/>
        <DataGridTemplateColumn Header="وضعیت" SortMemberPath="Status" Width="1.05*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Border CornerRadius="10" Background="{Binding StatusBackground}" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" HorizontalAlignment="Center"/></Border>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="تاریخ" Binding="{Binding Time}" ElementStyle="{StaticResource NumericCell}" Width="1.0*" MinWidth="85"/>
        <DataGridTemplateColumn Header="عملیات" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Button Content="جزئیات" Style="{StaticResource Secondary}" Height="28" Padding="7,0" FontSize="10" Click="Details_Click"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" x:Name="TableCount" Foreground="{StaticResource Muted}" FontSize="11"/>
     </Grid>
    </Border>
   </Grid>
   <ContentControl Grid.Row="2" x:Name="InvoiceWorkspace" Visibility="Collapsed"/>
   <Border Grid.Row="2" x:Name="OtherView" Style="{StaticResource Card}" Visibility="Collapsed" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OtherContent"/></ScrollViewer>
   </Border>
   <Grid Grid.Row="2" x:Name="OperationsView" Visibility="Collapsed" Background="#FFFDFA"/>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Background="#FFFCF8" Padding="15,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ClockLabel" FontSize="10" Foreground="{StaticResource Muted}"/>
    <TextBlock Grid.Column="1" Text="نجف، عراق" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="FooterMode" Grid.Column="2" Text="0.2.5  |  نسخه بومی WPF" HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource Muted}"/>
   </Grid>
  </Border>
 </Grid>
</Window>